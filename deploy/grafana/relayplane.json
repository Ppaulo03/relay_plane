     "legendFormat": "outbound FAILED/UNKNOWN",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Event delivery lag by type (p50 / p95, first attempt)",
   "id": 7,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le, event_type) (rate(relayplane_event_delivery_lag_seconds_bucket{attempt=\"first\"}[5m])))",
     "legendFormat": "p50 {{event_type}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le, event_type) (rate(relayplane_event_delivery_lag_seconds_bucket{attempt=\"first\"}[5m])))",
     "legendFormat": "p95 {{event_type}}",
