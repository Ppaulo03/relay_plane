{
 "title": "RelayPlane",
 "uid": "relayplane-overview",
 "tags": [
  "relayplane"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "editable": true,
 "description": "Generated from the metrics in internal/observability/metrics.go and the SLO rules in deploy/prometheus/slo.yml.",
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus",
    "label": "Prometheus",
    "current": {}
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "type": "row",
   "title": "Service level objectives (30 days; deploy/prometheus/slo.yml)",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "API: error budget left (SLO 99.9 % non-5xx)",
   "id": 2,
   "description": "Share of the 30-day error budget not yet spent. Below 0 the objective is missed.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.25
       },
       {
        "color": "green",
        "value": 0.5
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - relayplane:api_errors:ratio_rate30d / 0.001",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "type": "stat",
   "title": "Events: budget left (SLO 99 % first attempts \u2264 2 s)",
   "id": 3,
   "description": "",
