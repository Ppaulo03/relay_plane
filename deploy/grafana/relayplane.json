   "id": 5,
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 18,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
